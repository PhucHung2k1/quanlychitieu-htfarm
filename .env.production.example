# 1. Cơ sở dữ liệu PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ThayMatKhauPostgresManhTaiDay2026
POSTGRES_DB=quanlychitieu
DATABASE_URL=postgresql://postgres:ThayMatKhauPostgresManhTaiDay2026@postgres:5432/quanlychitieu?schema=public

# 2. Redis & Port
PORT=3001
REDIS_HOST=redis
REDIS_PORT=6379

# 3. Bảo mật Auth JWT (Đổi chuỗi ngẫu nhiên bí mật dài trên 32 ký tự)
JWT_SECRET=htfarm_production_super_secret_jwt_key_2026_random_string_xyz
JWT_EXPIRES_IN=7d

# 4. Trợ lý AI OCR Hóa đơn (Google Gemini API Key)
GEMINI_API_KEY=AIzaSy...

# 5. Lưu trữ ảnh chứng từ - Cloudflare R2 (Khuyên dùng)
# Nếu chưa có thông tin R2, hãy để trống, hệ thống sẽ tự động lưu vào ổ cứng VPS
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=htfarm-bills
R2_PUBLIC_URL=
